{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "namviet-erp",
    "Audience": "namviet-erp-client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "SessionRefreshTokenDays": 1
  },
  "AuthCookies": {
    "Secure": false,
    "SameSite": "Lax",
    "Domain": ""
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://localhost:5174"
  },
  "ForwardedHeaders": {
    "ClearKnownLists": true,
    "KnownProxies": ""
  },
  "FileStorage": {
    "Root": ""
  },
  "RateLimiting": {
    "AuthPermitLimit": 120,
    "PublicWritePermitLimit": 30,
    "PublicUploadPermitLimit": 30,
    "PublicReadPermitLimit": 180
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
