{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "namviet-erp",
    "Audience": "namviet-erp-client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SessionRefreshTokenDays": 1
  },
  "AuthCookies": {
    "Secure": true,
    "SameSite": "Lax",
    "Domain": ""
  },
  "Cors": { 
    "AllowedOrigins": "https://your-frontend-domain.com"
  },
  "ForwardedHeaders": {
    "ClearKnownLists": true,
    "KnownProxies": ""
  },
  "RateLimiting": {
    "AuthPermitLimit": 120,
    "PublicWritePermitLimit": 30,
    "PublicUploadPermitLimit": 30,
    "PublicReadPermitLimit": 180
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
