# ───────────────────────────────────────────────
# NamViet ERP Backend - Environment variables
# Copy to .env and adjust for your machine
# ───────────────────────────────────────────────

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=namviet_erp
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=change_me_strong

# ConnectionStrings:Default is built from the values above in appsettings,
# or override it directly here:
ConnectionStrings__Default=Host=localhost;Port=5432;Database=namviet_erp;Username=erp_admin;Password=change_me_strong

# JWT
Jwt__Issuer=namviet-erp
Jwt__Audience=namviet-erp-client
Jwt__SigningKey=replace_with_a_long_random_secret_at_least_32_chars
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7

# Default admin seed
Seed__AdminEmail=admin@namviet.vip
Seed__AdminPassword=Admin@12345

# CORS (frontend origins, comma separated)
Cors__AllowedOrigins=http://localhost:5173,http://localhost:5174
