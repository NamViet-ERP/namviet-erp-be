# ───────────────────────────────────────────────
# NamViet ERP Backend - Environment variables
# Copy to `.env` in repo root (for docker compose) and/or set user-secrets for API.
# Do NOT commit `.env` with real passwords.
# ───────────────────────────────────────────────

# PostgreSQL (docker compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=namviet_erp
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=          # required — choose a strong password

# PgAdmin (docker compose only)
PGADMIN_PASSWORD=           # required when using pgadmin service

# API connection string (override appsettings)
ConnectionStrings__Default=Host=localhost;Port=5434;Database=namviet_erp;Username=erp_admin;Password=

# JWT — must be ≥32 chars, not a placeholder
Jwt__Issuer=namviet-erp
Jwt__Audience=namviet-erp-client
Jwt__SigningKey=            # required — random secret ≥32 characters
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7

# CORS (frontend origins, comma separated)
Cors__AllowedOrigins=http://localhost:5173,http://localhost:5174

# ── Quick setup (API without .env file) ─────────────────
# cd src/ApiHost/NamViet.ERP.Api
# dotnet user-secrets set "ConnectionStrings:Default" "Host=localhost;Port=5434;..."
# dotnet user-secrets set "Jwt:SigningKey" "your-random-secret-at-least-32-chars"
