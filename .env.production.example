# ───────────────────────────────────────────────
# NamViet ERP Backend — Production environment template
# Copy to host secrets / systemd EnvironmentFile / Docker secrets.
# Do NOT commit a filled .env.production with real passwords.
# ───────────────────────────────────────────────

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

# PostgreSQL — strong password required (validator rejects known weak markers)
ConnectionStrings__Default=Host=db.example.com;Port=5432;Database=namviet_erp;Username=erp_admin;Password=

# JWT — SigningKey ≥32 chars, random, not a placeholder
Jwt__Issuer=namviet-erp
Jwt__Audience=namviet-erp-client
Jwt__SigningKey=
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7
Jwt__SessionRefreshTokenDays=1

# CORS — real frontend origin(s), comma-separated.
# Must NOT remain https://your-frontend-domain.com on Production.
Cors__AllowedOrigins=https://erp.example.com

# Auth cookies (HTTPS)
AuthCookies__Secure=true
AuthCookies__SameSite=Lax
# AuthCookies__Domain=.example.com

# Reverse proxy — set KnownProxies when API is reachable beyond a trusted edge
ForwardedHeaders__ClearKnownLists=true
# ForwardedHeaders__KnownProxies=10.0.0.5

# Optional private upload root
# FileStorage__Root=/var/namviet/private-uploads
